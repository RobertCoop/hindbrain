#!/usr/bin/env python3
"""hindbrain mem CLI (spec §9). Exit codes: 0 ok, 1 user error, 2 refused."""
import argparse
import json
import os
import re
import sqlite3
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from lib import db, ids, log, paths, querybuild, render, scoring, state, witness
from lib import secrets as secretscan

KINDS = ("gotcha", "decision", "preference", "fact", "procedure", "env")
SCOPE_TYPES = ("global", "project", "path", "command", "tool")
AUTH_RANK = {"quarantined": 0, "pending": 1, "standard": 2, "full": 3}
AUTH_BY_CHANNEL = {"user_witnessed": "full", "observer_witnessed": "standard",
                   "agent": "pending", "external": "quarantined"}

_NEG = re.compile(r"(?i)\b(not|never|don'?t|do not|instead|avoid|no longer|stop)\b")


def emit(lines):
    text = "\n".join(str(l) for l in lines)
    out = text.split("\n")
    if len(out) > 30:
        out = out[:29] + ["… (truncated)"]
    print("\n".join(out))


def fail(msg):
    print(f"mem: {msg}", file=sys.stderr)
    return 1


def refuse(msg):
    print(f"mem: refused: {msg}", file=sys.stderr)
    return 2


def parse_scope(s):
    st, _, sv = (s or "").partition(":")
    st = st.strip()
    sv = sv.strip()
    if st not in SCOPE_TYPES:
        raise ValueError(f"scope type must be one of {'|'.join(SCOPE_TYPES)}")
    if st in ("path", "command", "tool") and not sv:
        raise ValueError(f"scope {st}: requires a value (e.g. {st}:<value>)")
    if st in ("global", "project"):
        sv = ""
    return st, sv


def resolve_mem(conn, mem_id):
    m = db.get_memory(conn, mem_id)
    if m is None:
        raise LookupError(f"memory not found (or ambiguous prefix): {mem_id}")
    return m


def scope_str(m):
    sv = m.get("scope_value") or ""
    st = m.get("scope_type") or ""
    return f"{st}:{sv}" if sv else st


def open_candidates(conn, session, project=None):
    # session rows + unbound rows younger than 2h (§3.4 degraded binding)
    cutoff = int(time.time()) - 7200
    rows = conn.execute(
        "SELECT * FROM candidate WHERE status='open' AND "
        "(session_id = ? OR (session_id = 'unbound' AND ts > ?)) "
        "ORDER BY ts, id", (session, cutoff)).fetchall()
    out = [dict(r) for r in rows]
    if session == "unbound" and project:
        # symmetric degraded binding: an unbound CLI can still see recent
        # session-bound candidates for this project (the stop hook created
        # them with the session id the CLI failed to inherit)
        seen = {c["id"] for c in out}
        extra = conn.execute(
            "SELECT * FROM candidate WHERE status='open' AND ts > ? "
            "AND session_id != 'unbound' ORDER BY ts, id",
            (cutoff,)).fetchall()
        for r in extra:
            c = dict(r)
            if c["id"] in seen:
                continue
            try:
                p = json.loads(c.get("payload") or "{}")
            except (ValueError, TypeError):
                continue
            if isinstance(p, dict) and p.get("project") == project:
                out.append(c)
        out.sort(key=lambda c: (c.get("ts") or 0, c["id"]))
    return out


def pick_candidate(conn, session, ref, project=None):
    cands = open_candidates(conn, session, project)
    try:
        n = int(ref)
        if 1 <= n <= len(cands):
            return cands[n - 1]
        return None
    except ValueError:
        pass
    hits = [c for c in cands if c["id"].startswith(ref)]
    return hits[0] if len(hits) == 1 else None


def token_jaccard(a, b):
    wa, wb = witness.content_words(a), witness.content_words(b)
    if not wa or not wb:
        return 0.0
    return len(wa & wb) / len(wa | wb)


def turn_tainted(conn, session):
    turn = state.load(session, "main").get("turn", 0)
    rows = conn.execute(
        "SELECT data FROM journal WHERE session_id=? AND event='taint' "
        "ORDER BY ts DESC LIMIT 50", (session,)).fetchall()
    for r in rows:
        try:
            d = json.loads(r["data"])
        except (ValueError, TypeError):
            continue
        if isinstance(d, dict) and d.get("turn") == turn:
            return True
    return False


def decide_channel(body, session, conn, cfg, channel_flag, cand, project=None):
    if channel_flag == "external":
        return "external", "declared --channel external"
    notes = []
    if channel_flag == "user":
        notes.append("--channel user ignored (witness test decides)")
    if cand is not None and witness.observer_witnessed(cand):
        notes.append("observer-recorded candidate evidence")
        return "observer_witnessed", "; ".join(notes)
    if witness.user_witnessed(body, session, conn, cfg, project=project):
        notes.append("matches a logged user turn")
        return "user_witnessed", "; ".join(notes)
    notes.append("agent-authored, no witness")
    return "agent", "; ".join(notes)


def _corroborated_this_session(conn, session, mem_id):
    rows = conn.execute(
        "SELECT data FROM journal WHERE session_id=? AND event='corroborate' "
        "ORDER BY ts DESC LIMIT 200", (session,)).fetchall()
    for r in rows:
        try:
            d = json.loads(r["data"])
        except (ValueError, TypeError):
            continue
        if isinstance(d, dict) and d.get("memory_id") == mem_id:
            return True
    return False


def apply_corroborate(conn, cfg, session, mem_id):
    # idempotent per (memory, session): a retry loop (e.g. repeated failed
    # mem confirm attempts) must not ratchet count -> standard authority
    if _corroborated_this_session(conn, session, mem_id):
        m = db.get_memory(conn, mem_id)
        return m, "already corroborated this session (count unchanged)"
    conn.execute("UPDATE memory SET corroborations = corroborations + 1 "
                 "WHERE id = ?", (mem_id,))
    conn.commit()
    db.log_access(conn, mem_id, session, "main", "cited")
    db.journal(conn, session, "main", "corroborate", {"memory_id": mem_id})
    m = db.get_memory(conn, mem_id)
    note = ""
    if m["authority"] == "pending" and m["corroborations"] >= 2:
        conn.execute("UPDATE memory SET authority='standard' WHERE id=?", (mem_id,))
        conn.commit()
        note = "promoted pending -> standard"
    elif m["authority"] == "quarantined" and m["corroborations"] >= 2:
        sess = set()
        rows = conn.execute(
            "SELECT session_id, data FROM journal WHERE event='corroborate' "
            "ORDER BY ts DESC LIMIT 500").fetchall()
        for r in rows:
            try:
                d = json.loads(r["data"])
            except (ValueError, TypeError):
                continue
            if isinstance(d, dict) and d.get("memory_id") == mem_id and r["session_id"]:
                sess.add(r["session_id"])
        if len(sess) >= 2:
            conn.execute("UPDATE memory SET authority='standard' WHERE id=?", (mem_id,))
            conn.commit()
            note = "promoted quarantined -> standard (distinct-session corroborations)"
        else:
            note = f"quarantined: {len(sess)}/2 distinct sessions so far"
    return db.get_memory(conn, mem_id), note


def insert_memory(conn, cfg, session, *, title, body, kind, scope_type, scope_value,
                  project, tags, channel, authority, hazard, hazard_mode,
                  supersedes, prior, source_event):
    mid = ids.ulid()
    now = int(time.time())
    conn.execute(
        "INSERT INTO memory (id,title,body,kind,scope_type,scope_value,project,tags,"
        "channel,authority,hazard,hazard_mode,supersedes,prior,source_session,"
        "source_event,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
        (mid, title, body, kind, scope_type, scope_value, project, tags,
         channel, authority, int(hazard), hazard_mode, supersedes, prior,
         session, source_event, now))
    # synthetic prior row (§6.3); not a use, so no access_count bump
    conn.execute(
        "INSERT INTO access_log(memory_id,session_id,agent_id,ts,event,weight) "
        "VALUES (?,?,?,?,'synthetic',?)", (mid, session, "main", now, prior))
    conn.commit()
    return mid


# ---- commands ----

def cmd_save(args, conn, cfg, session, project):
    body = args.body.strip()
    reason = secretscan.scan((args.title or "") + "\n" + body)
    if reason:
        return refuse(f"secret detected ({reason}); not saved")
    if not 20 <= len(body) <= 2000:
        return fail(f"body must be 20..2000 chars (got {len(body)})")
    try:
        scope_type, scope_value = parse_scope(args.scope)
    except ValueError as e:
        return fail(str(e))
    if args.hazard_mode and not args.hazard:
        return fail("--hazard-mode requires --hazard")
    title = (args.title or body[:80]).strip()[:80]
    mem_project = "" if scope_type == "global" else project

    cand = None
    if args.from_candidate:
        cand = pick_candidate(conn, session, args.from_candidate, project)
        if cand is None:
            return fail(f"no open candidate {args.from_candidate} (see mem queue)")

    # resolution pass (§9.3 step 3)
    contradiction = None
    q = querybuild.fts_query(body)
    near = db.search(conn, q, mem_project or project, k=3) if q else []
    best, best_j = None, 0.0
    for n in near:
        j = token_jaccard(title + " " + body,
                          (n.get("title") or "") + " " + (n.get("body") or ""))
        if j > best_j:
            best, best_j = n, j
    if best is not None:
        conflict = _NEG.search(body) is not None
        conflict = conflict != (_NEG.search(best.get("body") or "") is not None)
        if best_j >= 0.75 and not conflict:
            m, note = apply_corroborate(conn, cfg, session, best["id"])
            if cand:
                conn.execute("UPDATE candidate SET status='saved' WHERE id=?",
                             (cand["id"],))
                conn.commit()
            log.metric({"hook": "mem", "cmd": "save", "resolved": "corroborate",
                        "id": best["id"], "session": session})
            lines = [f"corroborated existing [{m['id']}] (jaccard {best_j:.2f}); "
                     "no new record inserted"]
            if note:
                lines.append(note)
            emit(lines)
            return 0
        if best_j >= 0.55 and conflict:
            contradiction = (best["id"], best_j)

    channel, why = decide_channel(body, session, conn, cfg, args.channel, cand,
                                  project=project)
    authority = AUTH_BY_CHANNEL[channel]
    if turn_tainted(conn, session):
        cap = "quarantined" if channel == "external" else "pending"
        if AUTH_RANK[authority] > AUTH_RANK[cap]:
            authority = cap
            why += f"; tainted turn capped authority at {cap}"

    prior = cfg["scoring"]["prior_default"]
    if cand:
        prior = {"P0": cfg["scoring"]["prior_p0"], "P1": cfg["scoring"]["prior_p1"],
                 "P2": cfg["scoring"]["prior_p2"]}.get(cand["priority"], prior)
    if args.prior is not None:
        # explicit cold-start strength (bootstrap seeding); activation only —
        # authority is witness-derived and cannot be raised from here
        prior = min(3.0, max(0.5, args.prior))

    mid = insert_memory(
        conn, cfg, session, title=title, body=body, kind=args.kind,
        scope_type=scope_type, scope_value=scope_value, project=mem_project,
        tags=args.tags or "", channel=channel, authority=authority,
        hazard=bool(args.hazard), hazard_mode=args.hazard_mode or "deny",
        supersedes=None, prior=prior,
        source_event=f"candidate:{cand['id']}" if cand else "cli")
    if cand:
        conn.execute("UPDATE candidate SET status='saved' WHERE id=?", (cand["id"],))
        conn.commit()
    lines = [f"saved [{mid}] authority={authority}", f"why: {channel} channel — {why}"]
    if contradiction:
        db.journal(conn, session, "main", "contradiction_flag",
                   {"new_id": mid, "near_id": contradiction[0],
                    "jaccard": round(contradiction[1], 2)})
        lines.append(f"note: possible conflict with [{contradiction[0]}] "
                     f"(jaccard {contradiction[1]:.2f}); flagged for consolidator — "
                     f"consider mem supersede {contradiction[0]}")
    log.metric({"hook": "mem", "cmd": "save", "id": mid, "authority": authority,
                "channel": channel, "session": session})
    emit(lines)
    return 0


def cmd_get(args, conn, cfg, session, project):
    try:
        m = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    db.log_access(conn, m["id"], session, "main", "fetched",
                  weight=cfg["scoring"]["fetch_weight"])
    def _fn(st):
        if m["id"] not in st["fetched"]:
            st["fetched"].append(m["id"])
    try:
        state.update(session, "main", _fn)
    except Exception:
        pass
    log.metric({"hook": "mem", "cmd": "fetch", "id": m["id"], "session": session})
    now = int(time.time())
    haz = f" hazard({m['hazard_mode']})" if m["hazard"] else ""
    pin = " pinned" if m["pinned"] else ""
    lines = [
        f"[{m['id']}] {m['title']}",
        f"{m['kind']} · {scope_str(m)} · project={m['project'] or '(global)'}"
        f" · tags={m['tags'] or '-'}",
        f"channel={m['channel']} authority={m['authority']} status={m['status']}"
        f"{haz}{pin}",
        f"corroborations={m['corroborations']} · saved {render.age(m['created_at'], now)}"
        f" · used {m['access_count']}×"
        + (f" · supersedes {m['supersedes']}" if m["supersedes"] else ""),
        "body:", m["body"],
    ]
    rel = db.links_for(conn, m["id"])[:4]
    if rel:
        lines.append("related: " + " · ".join(
            f"[{oid}] ({s:.2f})" for oid, s, _src in rel))
    emit(lines)
    return 0


def _link_pair(conn, id_a, id_b):
    a = resolve_mem(conn, id_a)
    b = resolve_mem(conn, id_b)
    if a["id"] == b["id"]:
        raise LookupError("cannot link a memory to itself")
    return a, b


def cmd_link(args, conn, cfg, session, project):
    try:
        a, b = _link_pair(conn, args.a, args.b)
    except LookupError as e:
        return fail(str(e))
    strength = min(1.0, max(0.0, args.strength))
    verdict = db.upsert_link(conn, a["id"], b["id"], strength, source="cli")
    log.metric({"hook": "mem", "cmd": "link", "a": a["id"], "b": b["id"],
                "strength": strength, "session": session})
    th = cfg["thresholds"]
    tier = ("inject-with-anchor" if strength >= th["tau_hi"]
            else "remind-with-anchor" if strength >= th["tau_lo"]
            else "below tau_lo: dormant until the anchor scores high enough")
    emit([f"{verdict} link [{a['id']}] <-> [{b['id']}] strength={strength:.2f}",
          f"spread behavior at full anchor score: {tier}"])
    return 0


def cmd_unlink(args, conn, cfg, session, project):
    try:
        a, b = _link_pair(conn, args.a, args.b)
    except LookupError as e:
        return fail(str(e))
    if db.delete_link(conn, a["id"], b["id"]):
        emit([f"unlinked [{a['id']}] <-> [{b['id']}]"])
        return 0
    return fail("no link between those memories")


def cmd_links(args, conn, cfg, session, project):
    try:
        m = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    rel = db.links_for(conn, m["id"])
    if not rel:
        emit([f"[{m['id']}] has no links"])
        return 0
    lines = [f"links for [{m['id']}] \"{m['title']}\":"]
    for oid, s, src in rel:
        other = db.get_memory(conn, oid)
        title = (other or {}).get("title") or "(missing)"
        lines.append(f"  [{oid}] {s:.2f} ({src}) \"{title}\"")
    emit(lines)
    return 0


def cmd_search(args, conn, cfg, session, project):
    q = querybuild.fts_query(args.terms)
    if not q:
        emit(["no results (empty query)"])
        return 0
    if args.all_projects:
        try:
            rows = conn.execute(
                "SELECT m.*, bm25(memory_fts) AS bm25 FROM memory_fts "
                "JOIN memory m ON m.rowid = memory_fts.rowid "
                "WHERE memory_fts MATCH ? AND m.status='active' "
                "ORDER BY bm25(memory_fts) ASC LIMIT ?", (q, args.k)).fetchall()
            hits = [dict(r) for r in rows]
        except Exception:
            hits = []
    else:
        hits = db.search(conn, q, project, k=args.k)
    if not hits:
        emit(["no results"])
        return 0
    now = int(time.time())
    ctx = scoring.Ctx(session=session, project=project, cwd=os.getcwd())
    lines = []
    for h in hits:
        try:
            act = scoring.activation(
                db.activation_events(conn, h["id"], cfg["scoring"]["act_window"]),
                now, cfg)
            s = scoring.score(h, ctx, cfg, act)
        except Exception:
            s = 0.0
        lines.append(f"{h['id']} · {s:.2f} · {h['title']} · {scope_str(h)}"
                     f" · {render.age(h['created_at'], now)}")
    emit(lines)
    return 0


def cmd_list(args, conn, cfg, session, project):
    sql = "SELECT * FROM memory WHERE status='active'"
    params = []
    if args.kind:
        sql += " AND kind=?"
        params.append(args.kind)
    if args.project:
        sql += " AND project IN (?, '')"
        params.append(project)
    if args.pinned:
        sql += " AND pinned=1"
    sql += " ORDER BY created_at DESC LIMIT 29"
    rows = conn.execute(sql, params).fetchall()
    if not rows:
        emit(["no memories match"])
        return 0
    now = int(time.time())
    lines = []
    for r in rows:
        m = dict(r)
        pin = " ·pin" if m["pinned"] else ""
        lines.append(f"{m['id']} · {m['kind']} · {m['authority']}{pin} · "
                     f"{m['title']} ({scope_str(m)} · {render.age(m['created_at'], now)})")
    emit(lines)
    return 0


def cmd_queue(args, conn, cfg, session, project):
    cands = open_candidates(conn, session, project)
    if not cands:
        emit(["queue empty"])
        return 0
    lines = []
    for i, c in enumerate(cands, 1):
        try:
            payload = json.loads(c["payload"])
        except (ValueError, TypeError):
            payload = {}
        snippet = ""
        if isinstance(payload, dict):
            snippet = str(payload.get("text")
                          or payload.get("delta")
                          or payload.get("ok_cmd") or "")
        snippet = " ".join(snippet.split())[:120].replace('"', "'")
        lines.append(f"({i}) [{c['priority']} {c['signal']}] \"{snippet}\"")
        if c.get("near_match"):
            lines.append(f"    near-match [{c['near_match']}] — consider: "
                         f"mem corroborate {c['near_match']}")
        elif c.get("draft_cmd"):
            lines.append(f"    draft: {c['draft_cmd']}")
    emit(lines)
    return 0


def cmd_drop(args, conn, cfg, session, project):
    cand = pick_candidate(conn, session, args.n, project)
    if cand is None:
        return fail(f"no open candidate {args.n} (see mem queue)")
    conn.execute("UPDATE candidate SET status='dropped' WHERE id=?", (cand["id"],))
    conn.commit()
    log.metric({"hook": "mem", "cmd": "drop", "candidate": cand["id"],
                "signal": cand["signal"], "session": session})
    emit([f"dropped candidate ({args.n}) [{cand['signal']}]"])
    return 0


def cmd_corroborate(args, conn, cfg, session, project):
    try:
        m = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    m, note = apply_corroborate(conn, cfg, session, m["id"])
    log.metric({"hook": "mem", "cmd": "corroborate", "id": m["id"],
                "session": session})
    lines = [f"corroborated [{m['id']}] (count={m['corroborations']}, "
             f"authority={m['authority']})"]
    if note:
        lines.append(note)
    emit(lines)
    return 0


def cmd_confirm(args, conn, cfg, session, project):
    try:
        m = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    if witness.confirm_witnessed(m, session, conn, cfg, project=project):
        conn.execute("UPDATE memory SET authority='full' WHERE id=?", (m["id"],))
        conn.commit()
        db.log_access(conn, m["id"], session, "main", "cited")
        db.journal(conn, session, "main", "confirm", {"memory_id": m["id"]})
        log.metric({"hook": "mem", "cmd": "confirm", "id": m["id"],
                    "session": session})
        emit([f"confirmed [{m['id']}] authority=full (user confirmation witnessed)"])
        return 0
    # AM-5 downgrade
    m, note = apply_corroborate(conn, cfg, session, m["id"])
    log.metric({"hook": "mem", "cmd": "confirm_downgraded", "id": m["id"],
                "session": session})
    st, fb = witness.confirm_witness_stats(conn, session, project)
    lines = [f"no user confirmation found in the last 5 user turns — "
             f"downgraded to corroborate [{m['id']}] "
             f"(count={m['corroborations']}, authority={m['authority']})",
             f"searched session {session}: {st} user turn(s), plus {fb} recent "
             f"same-project turn(s) (any session) via fallback"]
    if st == 0 and fb == 0:
        lines.append("no user turns journaled for this session — hooks may be "
                     "journaling under a different session id (resume/fork), or "
                     "the message was a !-command (those never journal)")
    elif fb > st:
        lines.append("more recent turns exist under OTHER session ids — this "
                     "shell's session binding may be stale (concurrent session "
                     "overwrote the handshake); retry with "
                     "--session $CLAUDE_CODE_SESSION_ID")
    lines.append("full authority requires a chat message from the user naming "
                 "this note (its id or most of its title) with a cue word, "
                 "within their last 5 turns — a !-command never counts")
    lines.append(f'ask the user to say:  confirm {m["id"]}')
    if note:
        lines.append(note)
    emit(lines)
    return 0


def cmd_supersede(args, conn, cfg, session, project):
    try:
        old = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    body = args.body.strip()
    reason = secretscan.scan((args.title or "") + "\n" + body)
    if reason:
        return refuse(f"secret detected ({reason}); not saved")
    if not 20 <= len(body) <= 2000:
        return fail(f"body must be 20..2000 chars (got {len(body)})")
    kind = args.kind or old["kind"]
    if args.scope:
        try:
            scope_type, scope_value = parse_scope(args.scope)
        except ValueError as e:
            return fail(str(e))
    else:
        scope_type, scope_value = old["scope_type"], old["scope_value"]
    title = (args.title or body[:80]).strip()[:80]

    channel, why = decide_channel(body, session, conn, cfg, None, None,
                                  project=project)
    authority = AUTH_BY_CHANNEL[channel]
    if turn_tainted(conn, session):
        if AUTH_RANK[authority] > AUTH_RANK["pending"]:
            authority = "pending"
            why += "; tainted turn capped authority at pending"

    now = int(time.time())
    mid = insert_memory(
        conn, cfg, session, title=title, body=body, kind=kind,
        scope_type=scope_type, scope_value=scope_value, project=old["project"],
        tags=args.tags if args.tags is not None else old["tags"],
        channel=channel, authority=authority, hazard=bool(old["hazard"]),
        hazard_mode=old["hazard_mode"], supersedes=old["id"],
        prior=cfg["scoring"]["prior_default"], source_event=f"supersede:{old['id']}")
    conn.execute("UPDATE memory SET status='superseded', invalidated_at=? WHERE id=?",
                 (now, old["id"]))
    conn.commit()
    db.log_access(conn, old["id"], session, "main", "cited")
    log.metric({"hook": "mem", "cmd": "supersede", "id": mid, "old": old["id"],
                "session": session})
    emit([f"saved [{mid}] authority={authority}, supersedes [{old['id']}] "
          f"(now superseded)", f"why: {channel} channel — {why}"])
    return 0


def cmd_refute(args, conn, cfg, session, project):
    try:
        m = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    conn.execute("UPDATE memory SET status='refuted', invalidated_at=? WHERE id=?",
                 (int(time.time()), m["id"]))
    conn.commit()
    data = {"memory_id": m["id"]}
    if args.note:
        data["note"] = args.note[:500]
    db.journal(conn, session, "main", "refute", data)
    log.metric({"hook": "mem", "cmd": "refute", "id": m["id"], "session": session})
    emit([f"refuted [{m['id']}]; excluded from surfacing pending consolidator review"])
    return 0


def _set_pin(args, conn, cfg, session, project, value):
    try:
        m = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    conn.execute("UPDATE memory SET pinned=? WHERE id=?", (value, m["id"]))
    conn.commit()
    emit([f"{'pinned' if value else 'unpinned'} [{m['id']}]"])
    return 0


def cmd_audit(args, conn, cfg, session, project):
    try:
        m = resolve_mem(conn, args.id)
    except LookupError as e:
        return fail(str(e))
    now = int(time.time())
    lines = [f"[{m['id']}] {m['title']}",
             f"{m['kind']} · {scope_str(m)} · project={m['project'] or '(global)'}",
             f"channel={m['channel']} authority={m['authority']} status={m['status']}"
             f" corroborations={m['corroborations']} prior={m['prior']}",
             f"source: session={m['source_session'] or '-'}"
             f" event={m['source_event'] or '-'}"
             f" · created {render.age(m['created_at'], now)} ago"]
    # chain backwards (what this supersedes)
    cur, depth = m, 0
    while cur.get("supersedes") and depth < 5:
        prev = db.get_memory(conn, cur["supersedes"])
        if prev is None:
            lines.append(f"supersedes: {cur['supersedes']} (missing)")
            break
        lines.append(f"supersedes: [{prev['id']}] \"{prev['title']}\" ({prev['status']})")
        cur, depth = prev, depth + 1
    # chain forwards (what superseded this)
    rows = conn.execute("SELECT id, title, status FROM memory WHERE supersedes=?",
                        (m["id"],)).fetchall()
    for r in rows:
        lines.append(f"superseded by: [{r['id']}] \"{r['title']}\" ({r['status']})")
    if m.get("invalidated_at"):
        lines.append(f"invalidated {render.age(m['invalidated_at'], now)} ago")
    for oid, s, src in db.links_for(conn, m["id"])[:6]:
        lines.append(f"related_to: [{oid}] strength={s:.2f} ({src})")
    acc = conn.execute(
        "SELECT ts, event, weight, session_id FROM access_log WHERE memory_id=? "
        "ORDER BY ts DESC LIMIT 10", (m["id"],)).fetchall()
    lines.append(f"access log (last {len(acc)}):")
    for a in acc:
        stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(a["ts"]))
        lines.append(f"  {stamp} {a['event']} w={a['weight']:g} "
                     f"session={a['session_id'] or '-'}")
    emit(lines)
    return 0


def cmd_stats(args, conn, cfg, session, project):
    def counts(col):
        rows = conn.execute(
            f"SELECT {col}, COUNT(*) AS n FROM memory GROUP BY {col} ORDER BY n DESC"
        ).fetchall()
        return " ".join(f"{r[0]}={r['n']}" for r in rows) or "-"
    total = conn.execute("SELECT COUNT(*) FROM memory").fetchone()[0]
    open_c = conn.execute(
        "SELECT COUNT(*) FROM candidate WHERE status='open'").fetchone()[0]
    lines = [f"memories: {total} (open candidates: {open_c})",
             f"by kind:      {counts('kind')}",
             f"by authority: {counts('authority')}",
             f"by status:    {counts('status')}"]
    # inject-tier posture: config is operator intent, meta is the tuner
    th, _tl = scoring.effective_taus(cfg, {}, conn)
    auto = conn.execute(
        "SELECT value FROM meta WHERE key='auto_tau_hi'").fetchone()
    when = conn.execute(
        "SELECT value FROM meta WHERE key='tau_autotune_at'").fetchone()
    stamp = ""
    if when:
        try:
            stamp = " since " + time.strftime(
                "%Y-%m-%d", time.localtime(int(float(when["value"]))))
        except (ValueError, TypeError):
            pass
    if not cfg["thresholds"].get("auto_inject", True):
        lines.append(f"inject tier: tau_hi={th} (tuner disabled by config)")
    elif auto:
        lines.append(f"inject tier: ENABLED by tuner (effective tau_hi={th}"
                     f"{stamp}; revert: auto_inject=false)")
    elif th >= 1.0:
        lines.append("inject tier: remind-only; tuner watching acceptance "
                     "(enables at >0.15 with >=20 reminds/30d)")
    else:
        lines.append(f"inject tier: tau_hi={th} (set by operator config)")
    meta = conn.execute("SELECT key, value FROM meta ORDER BY key").fetchall()
    shown = 0
    for r in meta:
        if r["key"] in ("schema_version", "auto_tau_hi", "tau_autotune_at"):
            continue
        if r["key"] == "last_consolidation":
            try:
                stamp = time.strftime("%Y-%m-%d %H:%M",
                                      time.localtime(int(float(r["value"]))))
                lines.append(f"last consolidation: {stamp}")
            except (ValueError, TypeError):
                lines.append(f"last consolidation: {r['value']}")
            continue
        if r["key"] == "deny_rate_per_100_bash":
            lines.append(f"deny rate (30d): {r['value']} per 100 Bash calls"
                         " (alert if > 1)")
        elif r["key"] == "p95_gate_ms":
            lines.append(f"p95 gate latency: {r['value']} ms (rolling)")
        else:
            lines.append(f"{r['key']}: {r['value']}")
        shown += 1
        if shown >= 20:
            break
    if shown == 0:
        lines.append("no acceptance metrics yet (consolidator has not run)")
    emit(lines)
    return 0


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        # §9.1: exit 2 is reserved for refusals; usage errors are user errors
        self.print_usage(sys.stderr)
        print(f"mem: error: {message}", file=sys.stderr)
        raise SystemExit(1)


def cmd_scout(args, conn, cfg, session, project):
    # deterministic bootstrap survey (read-only; see the mem-init skill)
    from lib import scout
    root = os.path.abspath(args.path) if args.path else project
    if not os.path.isdir(root):
        return fail(f"not a directory: {root}")
    report = scout.run_scout(root)
    if args.as_json:
        print(json.dumps(report, indent=1))
    else:
        emit(scout.format_text(report))
    log.metric({"hook": "mem", "cmd": "scout", "session": session})
    return 0


def cmd_anchor(args, conn, cfg, session, project):
    # write the .hindbrain workspace anchor; resolution walks up from any
    # cwd to the nearest anchor, making workspace identity explicit
    root = os.path.abspath(args.path) if args.path else project
    if not os.path.isdir(root):
        return fail(f"not a directory: {root}")
    p = os.path.join(root, paths.ANCHOR_NAME)
    existing = paths.anchor_root(os.getcwd())
    if os.path.exists(p):
        emit([f"anchor already present: {p}", f"workspace root: {root}"])
        return 0
    with open(p, "w", encoding="utf-8") as f:
        f.write("# hindbrain workspace anchor — marks this directory as the "
                "workspace root for memory scoping.\n"
                "# Presence is what matters; content is reserved.\n")
    lines = [f"anchored workspace at {root}"]
    if existing and existing != root:
        lines.append(f"note: an enclosing anchor at {existing} exists; the "
                     f"NEAREST anchor above a given cwd wins")
    log.metric({"hook": "mem", "cmd": "anchor", "session": session})
    emit(lines)
    return 0


def _chunked(ids, n=500):
    for i in range(0, len(ids), n):
        yield ids[i:i + n]


def cmd_reinit(args, conn, cfg, session, project):
    # erase memory for a clean initialization. Workspace-scoped unless
    # --all-projects; previews without --yes; ALWAYS backs up first.
    if args.all_projects:
        mem_ids = [r[0] for r in conn.execute("SELECT id FROM memory")]
        scope_desc = "ALL projects (entire store)"
    else:
        mem_ids = [r[0] for r in conn.execute(
            "SELECT id FROM memory WHERE project = ?", (project,))]
        scope_desc = f"workspace {project} (global and other-project rows kept)"
    cands = []
    for r in conn.execute("SELECT id, payload FROM candidate"):
        if args.all_projects:
            cands.append(r["id"])
            continue
        try:
            p = json.loads(r["payload"] or "{}")
        except (ValueError, TypeError):
            continue
        if isinstance(p, dict) and p.get("project") == project:
            cands.append(r["id"])

    if not args.yes:
        emit([f"re-init would erase from {scope_desc}:",
              f"  {len(mem_ids)} memories (+ their access log and links)",
              f"  {len(cands)} candidates"
              + ("  + all journal rows" if args.all_projects else ""),
              "nothing was deleted. To proceed:",
              f"  mem re-init --yes{' --all-projects' if args.all_projects else ''}",
              "a timestamped backup of the store is taken first, always"])
        return 0

    base = paths.db_path() + time.strftime(".reinit-%Y%m%d-%H%M%S")
    backup = base + ".bak"
    n = 1
    while os.path.exists(backup):
        backup = f"{base}-{n}.bak"
        n += 1
    try:
        conn.execute("VACUUM INTO ?", (backup,))
    except sqlite3.OperationalError as e:
        return fail(f"backup failed ({e}); nothing was deleted")

    for chunk in _chunked(mem_ids):
        ph = ",".join("?" * len(chunk))
        conn.execute(f"DELETE FROM access_log WHERE memory_id IN ({ph})", chunk)
        conn.execute(f"DELETE FROM memory_link WHERE from_id IN ({ph}) "
                     f"OR to_id IN ({ph})", (*chunk, *chunk))
        conn.execute(f"DELETE FROM memory WHERE id IN ({ph})", chunk)
    for chunk in _chunked(cands):
        ph = ",".join("?" * len(chunk))
        conn.execute(f"DELETE FROM candidate WHERE id IN ({ph})", chunk)
    if args.all_projects:
        conn.execute("DELETE FROM journal")
        conn.execute("DELETE FROM meta WHERE key != 'schema_version'")
    conn.commit()
    db.journal(conn, session, "main", "reinit",
               {"project": None if args.all_projects else project,
                "memories": len(mem_ids), "candidates": len(cands),
                "backup": backup})
    log.metric({"hook": "mem", "cmd": "reinit", "session": session,
                "memories": len(mem_ids)})
    emit([f"erased {len(mem_ids)} memories and {len(cands)} candidates "
          f"from {scope_desc}",
          f"backup: {backup}",
          "store is clean — run /hindbrain:mem-init to reseed "
          "(restore any time: copy the backup over hindbrain.db)"])
    return 0


def build_parser():
    common = _Parser(add_help=False)
    common.add_argument("--db", default=argparse.SUPPRESS)
    common.add_argument("--session", default=argparse.SUPPRESS)

    p = _Parser(prog="mem", parents=[common],
                description="hindbrain persistent memory CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("save", parents=[common])
    sp.add_argument("--kind", required=True, choices=KINDS)
    sp.add_argument("--scope", required=True, metavar="TYPE:VALUE")
    sp.add_argument("--tags", default="")
    sp.add_argument("--title")
    sp.add_argument("--hazard", action="store_true")
    sp.add_argument("--hazard-mode", choices=("deny", "ask"))
    sp.add_argument("--channel", choices=("external", "user"))
    sp.add_argument("--from-candidate", metavar="N")
    sp.add_argument("--prior", type=float, default=None,
                    help="cold-start strength 0.5..3.0 (activation only)")
    sp.add_argument("body")
    sp.set_defaults(func=cmd_save)

    sp = sub.add_parser("get", parents=[common])
    sp.add_argument("id")
    sp.set_defaults(func=cmd_get)

    sp = sub.add_parser("search", parents=[common])
    sp.add_argument("terms")
    sp.add_argument("--all-projects", action="store_true")
    sp.add_argument("-k", type=int, default=8)
    sp.set_defaults(func=cmd_search)

    sp = sub.add_parser("list", parents=[common])
    sp.add_argument("--kind", choices=KINDS)
    sp.add_argument("--project", action="store_true")
    sp.add_argument("--pinned", action="store_true")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("queue", parents=[common])
    sp.set_defaults(func=cmd_queue)

    sp = sub.add_parser("drop", parents=[common])
    sp.add_argument("n")
    sp.set_defaults(func=cmd_drop)

    sp = sub.add_parser("corroborate", parents=[common])
    sp.add_argument("id")
    sp.set_defaults(func=cmd_corroborate)

    sp = sub.add_parser("confirm", parents=[common])
    sp.add_argument("id")
    sp.set_defaults(func=cmd_confirm)

    sp = sub.add_parser("supersede", parents=[common])
    sp.add_argument("id")
    sp.add_argument("body")
    sp.add_argument("--kind", choices=KINDS)
    sp.add_argument("--scope", metavar="TYPE:VALUE")
    sp.add_argument("--tags")
    sp.add_argument("--title")
    sp.set_defaults(func=cmd_supersede)

    sp = sub.add_parser("refute", parents=[common])
    sp.add_argument("id")
    sp.add_argument("note", nargs="?")
    sp.set_defaults(func=cmd_refute)

    sp = sub.add_parser("pin", parents=[common])
    sp.add_argument("id")
    sp.set_defaults(func=lambda *a: _set_pin(*a, 1))

    sp = sub.add_parser("unpin", parents=[common])
    sp.add_argument("id")
    sp.set_defaults(func=lambda *a: _set_pin(*a, 0))

    sp = sub.add_parser("audit", parents=[common])
    sp.add_argument("id")
    sp.set_defaults(func=cmd_audit)

    sp = sub.add_parser("stats", parents=[common])
    sp.set_defaults(func=cmd_stats)

    sp = sub.add_parser("scout", parents=[common])
    sp.add_argument("--json", action="store_true", dest="as_json")
    sp.add_argument("--path", default=None,
                    help="project root to survey (default: resolved workspace)")
    sp.set_defaults(func=cmd_scout)

    sp = sub.add_parser("anchor", parents=[common])
    sp.add_argument("--path", default=None,
                    help="directory to anchor (default: resolved workspace)")
    sp.set_defaults(func=cmd_anchor)

    sp = sub.add_parser("link", parents=[common])
    sp.add_argument("a")
    sp.add_argument("b")
    sp.add_argument("--strength", type=float, default=0.5,
                    help="0..1; >= tau_hi injects with its anchor, >= tau_lo reminds")
    sp.set_defaults(func=cmd_link)

    sp = sub.add_parser("unlink", parents=[common])
    sp.add_argument("a")
    sp.add_argument("b")
    sp.set_defaults(func=cmd_unlink)

    sp = sub.add_parser("links", parents=[common])
    sp.add_argument("id")
    sp.set_defaults(func=cmd_links)

    sp = sub.add_parser("re-init", parents=[common])
    sp.add_argument("--yes", action="store_true",
                    help="actually erase (without it: preview only)")
    sp.add_argument("--all-projects", action="store_true",
                    help="erase the ENTIRE store, not just this workspace")
    sp.set_defaults(func=cmd_reinit)
    return p


def main(argv):
    args = build_parser().parse_args(argv)
    if getattr(args, "db", None):
        dbp = os.path.abspath(args.db)
        try:
            os.makedirs(os.path.dirname(dbp), mode=0o700, exist_ok=True)
        except OSError:
            pass
        os.environ["HINDBRAIN_DB"] = dbp
    project0 = paths.resolve_project(os.getcwd())
    session = (getattr(args, "session", None)
               or os.environ.get("HINDBRAIN_SESSION")
               # harness-set in every Bash tool shell and race-free: unlike the
               # handshake, no concurrent session can clobber it
               or os.environ.get("CLAUDE_CODE_SESSION_ID")
               or paths.handshake_session(project0)  # non-CC-harness bridge
               or "unbound")
    # never silently create a divergent store: no flag, no env, no handshake,
    # and the fallback DB doesn't exist yet -> say so before creating it
    if (not getattr(args, "db", None)
            and not os.environ.get("HINDBRAIN_DB")
            and not os.environ.get("HINDBRAIN_DATA")
            and not os.environ.get("CLAUDE_PLUGIN_DATA")
            and paths.ancestor_handshake(os.getcwd()) is None
            and not os.path.exists(
                os.path.join(os.path.expanduser("~/.claude/hindbrain"),
                             "hindbrain.db"))):
        print("mem: note: no env or session handshake found — creating a new "
              "store at ~/.claude/hindbrain. If a hindbrain session is active "
              "elsewhere, its store lives under the plugin data dir; pass "
              "--db or run from that session.", file=sys.stderr)
    try:
        conn = db.connect()
        db.ensure_schema(conn)
    except Exception as e:
        return fail(f"cannot open database: {e}")
    try:
        cfg = paths.load_config()
        project = paths.resolve_project(os.getcwd())
        return args.func(args, conn, cfg, session, project)
    except Exception as e:
        return fail(str(e))
    finally:
        try:
            conn.close()
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
